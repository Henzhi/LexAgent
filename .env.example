# =============================================================
# Law-RAG-Agent 环境配置
# 复制此文件为 .env 后修改
# =============================================================

# ---- LLM 后端 ----
# 后端类型: ollama (本地) | openai (API)
# M1 起默认 openai（DeepSeek），Ollama 保留为降级后端
LLM_BACKEND=openai
# --- Ollama 配置（降级后端）---
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://localhost:11434
# --- OpenAI 兼容配置 (DeepSeek / 通义千问 / vLLM) ---
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-v4-flash

# --- 降级后端（主后端不可用时回退，REQ-UW2）---
# LLM_FALLBACK_BACKEND=ollama
# LLM_FALLBACK_MODEL=qwen2.5:3b
# LLM_FALLBACK_BASE_URL=http://localhost:11434

LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=3
# Ollama 请求上下文窗口 (num_ctx)：0=自动使用模型声明窗口；
# Ollama 服务端默认仅 2048，不显式下发会被静默截断。按显存调整（越大越占显存）
OLLAMA_NUM_CTX=0

# ---- Embedding 后端 ----
# 后端类型: ollama (本地) | openai (API)
# 不设置默认使用 ollama
EMBED_BACKEND=ollama
# --- Ollama 配置 ---
EMBED_MODEL=bge-m3
EMBED_BASE_URL=http://localhost:11434
# --- OpenAI 兼容配置 ---
# OPENAI_EMBED_MODEL=text-embedding-3-small

EMBED_BATCH_SIZE=32
EMBED_MAX_RETRIES=3

# ---- 检索 ----
RETRIEVAL_TOP_K=5
# 向量相似度召回阈值（bge-m3 归一化内积，范围约[-1,1]；0.95≈强相关、<0.4较差）
# 0.0=关闭；启用后可丢弃低相似度噪声候选
RETRIEVAL_SIM_THRESHOLD=0.4

# ---- LangGraph 多 Agent ----
# 开启后自动查询改写 + 答案校验防幻觉
AGENT_ENABLED=true
AGENT_MAX_RETRIES=1
# M1 工具调用型 Agent：AGENT_REACT_ENABLED=true 走 ReAct 循环（agent⇄tools）
# 设为 false 回退旧固定管线（AC-7 向后兼容）
AGENT_REACT_ENABLED=true
# ReAct 工具调用轮数上限（REQ-UW4）
AGENT_MAX_TOOL_TURNS=5
# 工具结果摘要长度上限（字符）：SSE tool_result.summary + LLM 回灌
TOOL_RESULT_SUMMARY_MAX_CHARS=300

# ---- 网络搜索 (Tavily, F3) ----
# Key 由后端统一管理，宿主机 .env 提供，经 docker-compose 注入容器
# TAVILY_API_KEY=tvly-xxx
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT=15.0

# ---- FAQ 语义缓存 ----
# FAQ 缓存 TTL（小时）：超过即销毁；命中缓存时自动顺延刷新（热问题续命）
FAQ_TTL_HOURS=1
# 过期缓存后台清理周期（小时）（仅 pgvector 后端生效，Redis 后端原生 TTL 自动过期）
FAQ_CLEAN_INTERVAL_HOURS=24
# FAQ 缓存后端: redis（Redis Stack，向量检索+原生TTL，默认）| pg（pgvector，无Redis环境回退）
FAQ_CACHE_BACKEND=redis
# Redis Stack 连接串（compose 宿主映射为 6381，避开 VMware/WSL 对 6379 的抢占；
# 若在容器内运行 app 则用 redis://redis:6379）
REDIS_URL=redis://localhost:6381

# ---- pgvector (唯一检索后端) ----
# v0.6 纯 PG 架构：默认且必须开启，无 FAISS 回退
PG_ENABLED=true
# compose 部署必填（docker-compose.yml 引用，未设置会拒绝启动）；
# 生产环境务必改为强随机值：openssl rand -hex 24
POSTGRES_PASSWORD=lawrag123
# 裸跑 uvicorn + 本机 PG 时的连接串（compose 内 app 的连接串由 compose 覆盖）
PG_CONN=postgresql://lawrag:lawrag123@localhost:5432/lawrag

# ---- 重排序 (Reranker) ----
# 需要 sentence-transformers + torch，首次加载较慢（~2GB 模型）
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_RECALL_K=15
RERANK_TOP_K=15

# ---- 相邻法条扩展 ----
# 检索时自动补全前后 N 条法条，保持法律条文连续性
# 注意: ±3 会把每条命中扩展成 7 条，引用列表被大量相邻但不相关的条文污染，
# 推荐 ±1（仅保留紧邻上下文，引用以检索命中为主）
ADJACENT_ENABLED=true
ADJACENT_WINDOW=1

# ---- BM25 条件混合检索 ----
# rank-based 融合（加权 RRF，只看排名不碰分数）：仅当查询含法名/条款号时激活，
# 通用语义查询保持纯向量零干扰。法条级评测: Hit@5 75.8%→86.1%
HYBRID_ENABLED=true
HYBRID_RRF_K=60
HYBRID_BM25_WEIGHT=3.0

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000

# ---- 北大法宝 MCP（官方法律源增强，F9 扩展，决策 D-PKULAW）----
# 默认连聚合端点（一个 URL 暴露全部 10 个工具）；若聚合不可用改指单个服务端点。
# URL 与 Bearer Token 由 pkulaw 提供（按积分计费，务必接预算熔断）。
# PKULAW_MCP_URL=https://apim-gateway.pkulaw.com/mcp-law-agg/mcp
# PKULAW_MCP_TOKEN=your-bearer-token
# PKULAW_TIMEOUT=30.0
# PKULAW_MAX_RESULTS=5
